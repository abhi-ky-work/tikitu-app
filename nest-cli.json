{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/tikitu-app/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/tikitu-app/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/tikitu-app",
  "projects": {
    "admin-service": {
      "type": "application",
      "root": "apps/admin-service",
      "entryFile": "main",
      "sourceRoot": "apps/admin-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-service/tsconfig.app.json"
      }
    },
    "authentication-service": {
      "type": "application",
      "root": "apps/authentication-service",
      "entryFile": "main",
      "sourceRoot": "apps/authentication-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/authentication-service/tsconfig.app.json"
      }
    },
    "booking-service": {
      "type": "application",
      "root": "apps/booking-service",
      "entryFile": "main",
      "sourceRoot": "apps/booking-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/booking-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "partner-service": {
      "type": "application",
      "root": "apps/partner-service",
      "entryFile": "main",
      "sourceRoot": "apps/partner-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/partner-service/tsconfig.app.json"
      }
    },
    "payment-service": {
      "type": "application",
      "root": "apps/payment-service",
      "entryFile": "main",
      "sourceRoot": "apps/payment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment-service/tsconfig.app.json"
      }
    },
    "tikitu-app": {
      "type": "application",
      "root": "apps/tikitu-app",
      "entryFile": "main",
      "sourceRoot": "apps/tikitu-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tikitu-app/tsconfig.app.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.app.json"
      }
    }
  }
}